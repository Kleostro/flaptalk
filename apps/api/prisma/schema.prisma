generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "bun"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
  engineType             = "client"
}

generator prismabox {
  provider                    = "prismabox"
  output                      = "../src/generated/prismabox"
  inputModel                  = true
  typeboxImportDependencyName = "elysia"
  typeboxImportVariableName   = "t"
}

datasource db {
  provider = "postgresql"
}
